[Unit]
Description=CNC Office Celery worker
After=network-online.target redis-server.service cnc-db-tunnel.service cnc-office-web.service
Wants=network-online.target redis-server.service cnc-db-tunnel.service

[Service]
Type=simple
User=cnc
Group=cnc
WorkingDirectory=/opt/cnc_office
EnvironmentFile=/etc/cnc-office/app.env
ExecStart=/opt/cnc_office/.venv/bin/celery -A config worker -l info --concurrency=2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
