#!/sbin/openrc-run

description="CNC Office Celery beat scheduler"
command="/bin/bash"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/cnc-office/${RC_SVCNAME}.log"
error_log="/var/log/cnc-office/${RC_SVCNAME}.log"

depend() {
    need net redis cnc-db-tunnel
    after cnc-office-web
}

start_pre() {
    checkpath -d -m 0755 -o cnc:cnc /var/log/cnc-office
    checkpath -d -m 0755 /run
    set -a
    . /etc/cnc-office/app.env
    set +a
    command_user="cnc:cnc"
    command_args="-lc 'cd ${PROJECT_DIR:-/opt/cnc_office} && exec .venv/bin/celery -A config beat -l info --schedule /opt/cnc_office/celerybeat-schedule'"
}
