#!/sbin/openrc-run

description="CNC Office Django web service"
command="/bin/bash"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/cnc-office/${RC_SVCNAME}.log"
error_log="/var/log/cnc-office/${RC_SVCNAME}.log"

depend() {
    need net redis cnc-db-tunnel
}

start_pre() {
    checkpath -d -m 0755 -o cnc:cnc /var/log/cnc-office
    checkpath -d -m 0755 /run
    checkpath -d -m 0755 -o cnc:cnc /opt/cnc_office/logs
    command_user="cnc:cnc"
    command_args="/opt/cnc_office/ops/start_web_openrc.sh"
}
