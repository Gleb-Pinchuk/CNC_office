VK_TOKEN=
VK_GROUP_ID=236777458
# Без Docker/systemd: бот ходит в локальный Gunicorn на app-сервере.
# В Docker Compose значение переопределяется на http://web:8000/api.
CNC_API_BASE=http://127.0.0.1:8000/api
CNC_BOT_SECRET=
CNC_SECTION_TYPE=rangers
# Фрагмент названия таблицы в разделе (как в CNC Office)
CNC_TABLE_TITLE_FRAGMENT=киберрейнджеры
# Имена листов-«направлений» (как в Google-версии файлов), через запятую
CNC_DIRECTION_SHEETS=ЧПУ,РОБО,Аэро,микро
TIMEZONE=Europe/Moscow
# Индексы колонок (как в Django BOT_SHEET_*), по умолчанию как в прод-таблице
BOT_SHEET_FIO_COL=2
BOT_SHEET_GROUP_COL=1
BOT_SHEET_STATUS_COL=12
# fallback-колонка замечаний (если в строке заголовка нет дат)
BOT_SHEET_REMARK_COL=11
BOT_SHEET_SOCIAL_COLS=4,5,6
