## Django
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=app.example.com,localhost,127.0.0.1
# Caddy endpoint:
# - local HTTP fallback: SITE_ADDRESS=:80
# - production HTTPS: SITE_ADDRESS=app.example.com
SITE_ADDRESS=:80
ACME_EMAIL=admin@example.com

## Database (PostgreSQL)
POSTGRES_DB=cnc_office
POSTGRES_USER=cnc_user
POSTGRES_PASSWORD=cnc_password
DB_HOST=db
DB_PORT=5432

## CORS/CSRF (trusted domains)
# CORS_ALLOW_ALL_ORIGINS=True/False
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated origins, e.g. http://213.165.214.241:8002
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=False

# Comma-separated CSRF trusted origins
CSRF_TRUSTED_ORIGINS=https://app.example.com

## Security (enable when you terminate TLS)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax

## VK bot + таблица в БД (источник — Nextcloud .xlsx, синхронизация отдельным сервисом)
VK_TOKEN=change-me
VK_GROUP_ID=0
TIMEZONE=Europe/Moscow
CNC_BOT_API_SECRET=change-me
CNC_BOT_TABLE_OWNER_USERNAME=admin
# Код раздела: rangers | attendance | statements
CNC_SECTION_TYPE=rangers
CNC_TABLE_TITLE_FRAGMENT=киберрейнджеры
# comma-separated sheet names (directions)
CNC_DIRECTION_SHEETS=РОБО,МИКРО,ЧПУ,АЭРО

## Nextcloud (WebDAV) — путь к тому же файлу, что открыт в OnlyOffice
NEXTCLOUD_BASE_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=nc_user
NEXTCLOUD_PASSWORD=app-password-or-token
# Путь к .xlsx внутри домашнего каталога пользователя Nextcloud (не полный WebDAV URL)
NEXTCLOUD_FILE_PATH=Students/rangers.xlsx

## OIDC (опционально): ENABLE_OIDC=true и все OIDC_* ниже
ENABLE_OIDC=false
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile

