## Django
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=app.example.com,localhost,127.0.0.1
# Caddy endpoint:
# - local HTTP fallback: SITE_ADDRESS=:80
# - production HTTPS: SITE_ADDRESS=app.example.com
SITE_ADDRESS=:80
ACME_EMAIL=admin@example.com

## Database (PostgreSQL)
POSTGRES_DB=cnc_office
POSTGRES_USER=cnc_user
POSTGRES_PASSWORD=cnc_password
DB_HOST=db
DB_PORT=5432

## CORS/CSRF (trusted domains)
# CORS_ALLOW_ALL_ORIGINS=True/False
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated origins, e.g. http://213.165.214.241:8002
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=False

# Comma-separated CSRF trusted origins
CSRF_TRUSTED_ORIGINS=https://app.example.com

## Security (enable when you terminate TLS)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax

## VK bot
VK_TOKEN=change-me
VK_GROUP_ID=0
TIMEZONE=Europe/Moscow
CNC_BOT_API_SECRET=change-me
CNC_BOT_TABLE_OWNER_USERNAME=admin
CNC_SECTION_TYPE=кибер рейнджеры
CNC_TABLE_TITLE_FRAGMENT=киберрейнджеры_производственная_группа
# comma-separated sheet names (directions)
CNC_DIRECTION_SHEETS=РОБО,МИКРО,ЧПУ,АЭРО

## Nextcloud (WebDAV) for VK bot write events
NEXTCLOUD_BOT_WRITE_ENABLED=False
NEXTCLOUD_BOT_WRITE_STRICT=False
NEXTCLOUD_BASE_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=bot-uploader
NEXTCLOUD_APP_PASSWORD=change-me-app-password
NEXTCLOUD_BOT_ROOT=CNC_office/vk_bot
NEXTCLOUD_TIMEOUT_SECONDS=10
NEXTCLOUD_RETRY_COUNT=2

