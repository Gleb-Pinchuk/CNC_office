## Django
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=app.example.com,localhost,127.0.0.1

## Database (PostgreSQL)
POSTGRES_DB=cnc_office
POSTGRES_USER=cnc_user
POSTGRES_PASSWORD=cnc_password
DB_HOST=db
DB_PORT=5432

## CORS/CSRF (trusted domains)
# CORS_ALLOW_ALL_ORIGINS=True/False
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated origins, e.g. http://213.165.214.241:8002
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=False

# Comma-separated CSRF trusted origins
CSRF_TRUSTED_ORIGINS=https://app.example.com

## Security (enable when you terminate TLS)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax

## Redis + Celery (синк Nextcloud → БД каждые 5 мин через beat + worker)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

## Колонки Excel (0-based), как в реальной таблице «Киберрейнджеры…»
BOT_SHEET_FIO_COL=2
BOT_SHEET_GROUP_COL=1
BOT_SHEET_STATUS_COL=11
# Базовая колонка замечаний (fallback), если в заголовке не найдена дата недели.
# Если в первой строке есть колонки с датами, бот автоматически выбирает нужную неделю.
BOT_SHEET_REMARK_COL=12
# Колонки с соцсетями (через запятую), ссылки выводятся студенту кликабельными
BOT_SHEET_SOCIAL_COLS=13,14,15

## VK bot + таблица в БД (источник — Nextcloud .xlsx; push в облако — Celery)
VK_TOKEN=change-me
VK_GROUP_ID=0
TIMEZONE=Europe/Moscow
CNC_BOT_API_SECRET=change-me
CNC_BOT_TABLE_OWNER_USERNAME=admin
# Код раздела: rangers | attendance | statements
CNC_SECTION_TYPE=rangers
CNC_TABLE_TITLE_FRAGMENT=киберрейнджеры
# comma-separated sheet names (directions)
CNC_DIRECTION_SHEETS=РОБО,МИКРО,ЧПУ,АЭРО

## AI moderation (free local stack, optional)
SOCIAL_MODERATION_ENABLED=False
# How often to run automatic scan in Celery beat
SOCIAL_MODERATION_SCHEDULE_MINUTES=180
# 0 = unlimited per run (can be heavy), recommended 30-100 on weak hosts
SOCIAL_MOD_MAX_STUDENTS_PER_RUN=50
# Max checked entries per social link
SOCIAL_MOD_MAX_ENTRIES_PER_LINK=5
# Max links per student profile
SOCIAL_MOD_MAX_LINKS_PER_STUDENT=3
# Optional path for trainable rules JSON
SOCIAL_MOD_RULES_PATH=/app/bot_api/moderation_data/rules.json
# pHash distance thresholds (lower is stricter)
SOCIAL_MOD_BLOCK_HASH_DISTANCE=6
SOCIAL_MOD_ALLOW_HASH_DISTANCE=4
# Optional outbound proxy for blocked networks (example: http://user:pass@host:port)
SOCIAL_MOD_PROXY_URL=
# Temporary skip switches for unstable sources
SOCIAL_MOD_SKIP_TG=False
SOCIAL_MOD_SKIP_TIKTOK=False

## Nextcloud (WebDAV) — тот же .xlsx, что в OnlyOffice (пароль — только app password / токен)
# Пример хоста: https://cloud.tassadara.ru
NEXTCLOUD_BASE_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=your_nextcloud_login
NEXTCLOUD_APP_TOKEN=or-use-NEXTCLOUD_PASSWORD
NEXTCLOUD_PASSWORD=
# Относительный путь к файлу от домашнего каталога пользователя Nextcloud, например:
# NEXTCLOUD_FILE_PATH=Documents/Киберрейнджеры_производственная_группа.xlsx
NEXTCLOUD_FILE_PATH=Documents/table.xlsx

## OIDC (опционально): ENABLE_OIDC=true и все OIDC_* ниже
ENABLE_OIDC=false
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile

