## Django
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=213.165.214.241,localhost,127.0.0.1

## Database (PostgreSQL)
POSTGRES_DB=cnc_office
POSTGRES_USER=cnc_user
POSTGRES_PASSWORD=cnc_password
DB_HOST=db
DB_PORT=5432

## CORS/CSRF (trusted domains)
# CORS_ALLOW_ALL_ORIGINS=True/False
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated origins, e.g. http://213.165.214.241:8002
CORS_ALLOWED_ORIGINS=http://213.165.214.241:8002

# Comma-separated CSRF trusted origins
CSRF_TRUSTED_ORIGINS=http://213.165.214.241:8002

## Security (enable when you terminate TLS)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

## VK bot
VK_TOKEN=change-me
VK_GROUP_ID=0
TIMEZONE=Europe/Moscow
CNC_BOT_API_SECRET=change-me
CNC_BOT_TABLE_OWNER_USERNAME=admin
CNC_SECTION_TYPE=кибер рейнджеры
CNC_TABLE_TITLE_FRAGMENT=киберрейнджеры_производственная_группа
# comma-separated sheet names (directions)
CNC_DIRECTION_SHEETS=РОБО,МИКРО,ЧПУ,АЭРО

