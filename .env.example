## Django
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

## Database (PostgreSQL)
## Без Docker/systemd: app-сервер ходит к DB-серверу через SSH-туннель 127.0.0.1:15432.
## Docker Compose переопределяет эти значения на DB_HOST=db и DB_PORT=5432.
POSTGRES_DB=cnc_office
POSTGRES_USER=cnc_user
POSTGRES_PASSWORD=cnc_password
DB_HOST=127.0.0.1
DB_PORT=15432

## CORS/CSRF (trusted domains)
# CORS_ALLOW_ALL_ORIGINS=True/False
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated origins. Leave empty when API is internal-only.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False

# Comma-separated CSRF trusted origins
CSRF_TRUSTED_ORIGINS=

## Security (enable secure cookies/HSTS only when you terminate TLS)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax

## Redis + Celery (синк Nextcloud → БД каждые 5 мин через beat + worker)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

## Колонки Excel (0-based), как в реальной таблице «Киберрейнджеры…»
BOT_SHEET_FIO_COL=2
BOT_SHEET_GROUP_COL=1
BOT_SHEET_STATUS_COL=12
# Базовая колонка замечаний (fallback), если в заголовке не найдена дата недели.
# Если в первой строке есть колонки с датами, бот автоматически выбирает нужную неделю.
BOT_SHEET_REMARK_COL=11
# Колонки с соцсетями (через запятую), ссылки выводятся студенту кликабельными
BOT_SHEET_SOCIAL_COLS=4,5,6
MONITORING_REPORT_DEVELOPER=Тагирова А.Р.
MONITORING_REPORT_APPROVER=Яшев Э.А.

## VK bot + таблица в БД (источник — Nextcloud .xlsx; push в облако — Celery)
VK_TOKEN=change-me
VK_GROUP_ID=0
CNC_API_BASE=http://127.0.0.1:8000/api
TIMEZONE=Europe/Moscow
CNC_BOT_API_SECRET=change-me
CNC_BOT_SECRET=change-me
CNC_BOT_TABLE_OWNER_USERNAME=admin
# Код раздела: rangers | attendance | statements
CNC_SECTION_TYPE=rangers
CNC_TABLE_TITLE_FRAGMENT=киберрейнджеры
# Старый single-table режим (совместимость): comma-separated sheet names (directions)
CNC_DIRECTION_SHEETS=РОБО,МИКРО,ЧПУ,АЭРО
# Новый multi-table режим для VK-бота.
# Можно использовать Unicode-escape (\uXXXX), чтобы хранить только ASCII и избежать проблем Alpine/.env.
CNC_TABLE_GROUPS_JSON=[{"key":"production","title":"\u041f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f","table_title":"\u0420\u0435\u0439\u043d\u0434\u0436\u0435\u0440\u044b_\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f_\u0433\u0440\u0443\u043f\u043f\u0430","section_type":"rangers","directions":["\u0427\u041f\u0423","\u041c\u0418\u041a\u0420\u041e","\u0410\u042d\u0420\u041e","\u0420\u041e\u0411\u041e"]},{"key":"operations","title":"\u042d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u044f","table_title":"\u0420\u0435\u0439\u043d\u0434\u0436\u0435\u0440\u044b_\u0433\u0440\u0443\u043f\u043f\u0430_\u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438","section_type":"rangers","directions":["\u0425\u0438\u043c\u0411\u0438\u043e","\u042d\u043b\u041c\u043e\u043d\u0442\u0430\u0436","\u0411\u0418\u041c","\u041f\u0440\u043e\u043c\u0411\u0435\u0437","\u041a\u0438\u041f\u0438\u0410","\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0430"]},{"key":"integration","title":"\u0418\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f","table_title":"\u0420\u0435\u0439\u043d\u0434\u0436\u0435\u0440\u044b_\u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f_\u0433\u0440\u0443\u043f\u043f\u0430","section_type":"rangers","directions":["\u042e\u0440\u0438\u0441\u043f\u0440\u0443\u0434\u0435\u043d\u0446\u0438\u044f","\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0430","\u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u0435","\u042d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430","\u0410\u043b\u0430\u0431\u0443\u0433\u0430 \u0421\u0442\u0430\u0440\u0442"]},{"key":"programming","title":"\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435","table_title":"\u0420\u0435\u0439\u043d\u0434\u0436\u0435\u0440\u044b_\u0433\u0440\u0443\u043f\u043f\u0430_\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f","section_type":"rangers","directions":["Python","\u0411\u0438\u0437\u043d\u0435\u0441-\u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430"]}]

## AI moderation (free local stack, optional)
SOCIAL_MODERATION_ENABLED=False
# How often to run automatic scan in Celery beat
SOCIAL_MODERATION_SCHEDULE_MINUTES=180
# 0 = unlimited per run (can be heavy), recommended 30-100 on weak hosts
SOCIAL_MOD_MAX_STUDENTS_PER_RUN=50
# Max checked entries per social link (VK wall posts)
SOCIAL_MOD_MAX_ENTRIES_PER_LINK=10
# Max links per student profile
SOCIAL_MOD_MAX_LINKS_PER_STUDENT=3
# Optional path for trainable rules JSON
SOCIAL_MOD_RULES_PATH=/app/bot_api/moderation_data/rules.json
SOCIAL_MOD_BANNED_VK_GROUPS_PATH=/app/bot_api/moderation_data/banned_vk_groups.json
# pHash distance thresholds (lower is stricter)
SOCIAL_MOD_BLOCK_HASH_DISTANCE=6
SOCIAL_MOD_ALLOW_HASH_DISTANCE=4
# Optional outbound proxy for blocked networks (example: http://user:pass@host:port)
SOCIAL_MOD_PROXY_URL=
# По умолчанию только VK (TG/TikTok в РФ без VPN недоступны)
SOCIAL_MOD_SKIP_TG=True
SOCIAL_MOD_SKIP_TIKTOK=True

## Nextcloud (WebDAV) — тот же .xlsx, что в OnlyOffice (пароль — только app password / токен)
# Пример хоста: https://cloud.tassadara.ru
NEXTCLOUD_BASE_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=your_nextcloud_login
NEXTCLOUD_APP_TOKEN=or-use-NEXTCLOUD_PASSWORD
NEXTCLOUD_PASSWORD=
# Относительный путь к файлу от домашнего каталога пользователя Nextcloud, например:
# NEXTCLOUD_FILE_PATH=Documents/Киберрейнджеры_производственная_группа.xlsx
NEXTCLOUD_FILE_PATH=Documents/table.xlsx
# Новый multi-table sync режим (если задан, перекрывает single NEXTCLOUD_* режим):
# NEXTCLOUD_SYNC_GROUPS_JSON=[{"key":"production","label":"...","file_relative_path":"Documents/file1.xlsx","title_fragment":"Рейнджеры_производственная_группа"}, ...]

## OIDC (опционально): ENABLE_OIDC=true и все OIDC_* ниже
ENABLE_OIDC=false
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile

